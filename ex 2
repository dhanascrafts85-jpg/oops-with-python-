class Student:
    def __init__(self, name, roll_number):
        self.name = name
        self.roll_number = roll_number
        self.marks = {}

    def add_mark(self, subject, score):
        """Adds or updates a score for a given subject."""
        if 0 <= score <= 100:
            self.marks[subject] = score
            print(f"Added {subject}: {score}")
        else:
            print(f"Invalid score {score}. Must be between 0 and 100.")

    def calculate_average(self):
        """Calculates and returns the average percentage."""
        if not self.marks:
            return 0.0
        return sum(self.marks.values()) / len(self.marks)

    def get_grade(self):
        """Determines the letter grade based on the average."""
        avg = self.calculate_average()
        if avg >= 90:
            return "A"
        elif avg >= 75:
            return "B"
        elif avg >= 60:
            return "C"
        elif avg >= 40:
            return "D"
        else:
            return "F"

    def display_report(self):
        """Prints a summary of the student's performance."""
        print("\n" + "=" * 30)
        print(f"Student Report: {self.name} (ID: {self.roll_number})")
        print("-" * 30)
        for subject, score in self.marks.items():
            print(f"{subject:<15}: {score}")
        print("-" * 30)
        print(f"Average Score  : {self.calculate_average():.2f}")
        print(f"Final Grade    : {self.get_grade()}")
        print("=" * 30 + "\n")


# --- Demonstration ---
student1 = Student("Rohan", 101)

# Add marks using class methods
student1.add_mark("Python", 88)
student1.add_mark("Data Structures", 92)
student1.add_mark("Math", 79)

# Generate and view the report
student1.display_report()
