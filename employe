class Employee:
    emp_id = "EMP102"
    emp_name = "karthik"
    basic = 25000.0

    def calculate_total_salary(self):
        hra = self.basic * 0.20
        da = self.basic * 0.10
        total = self.basic + hra + da

        print("Employee ID:", self.emp_id)
        print("Employee Name:", self.emp_name)
        print("Basic Salary:", self.basic)
        print("HRA:", hra)
        print("DA:", da)
        print("Total Salary:", total)


e = Employee()
e.calculate_total_salary()
